[Unit]
Description=What's That Smoke robot dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=advanced
Group=advanced
WorkingDirectory=/home/advanced/whats-that-smoke
ExecStart=/home/advanced/whats-that-smoke/.venv/bin/uvicorn whats_that_smoke.web:app --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=5
NoNewPrivileges=true
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
